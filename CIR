숫자1 = float(input("첫 번째 숫자: "))
연산자 = input("연산자 (+, -, *, /): ")
숫자2 = float(input("두 번째 숫자: "))

if 연산자 == "+":
    결과 = 숫자1 + 숫자2
elif 연산자 == "-":
    결과 = 숫자1 - 숫자2
elif 연산자 == "*":
    결과 = 숫자1 * 숫자2
elif 연산자 == "/":
    if 숫자2 == 0:
        결과 = "0으로 나눌 수 없어요!"
    else:
        결과 = 숫자1 / 숫자2

print("결과:", 결과)